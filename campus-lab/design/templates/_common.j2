!
! Generated from design/group_vars and design/host_vars by design/render.yml.
! Do not edit a device config by hand: change the model and re-render.
!
version 17.9
service timestamps debug datetime msec localtime show-timezone
service timestamps log datetime msec localtime show-timezone
service password-encryption
service tcp-keepalives-in
service tcp-keepalives-out
no service pad
!
! Rollback point and change record. Every configure session is archived before
! it applies and logged line by line to syslog, so a change can be undone with
! 'configure replace' and reconstructed afterwards without trusting memory.
archive
 path flash:archive
 maximum 10
 write-memory
 log config
  logging enable
  notify syslog contenttype plaintext
  hidekeys
!
hostname {{ inventory_hostname }}
!
no ip domain lookup
ip domain name {{ domain_name }}
{% for server in name_servers %}
ip name-server {{ server }}
{% endfor %}
!
aaa new-model
aaa authentication login default local
aaa authorization exec default local
!
! Local fallback account. Without it, 'authentication login default local'
! locks every operator out of the console the moment it is applied. The hash
! is a placeholder replaced at deploy time from the credential store.
username {{ local_admin.username }} privilege 15 secret 9 {{ local_admin.secret_hash }}
!
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
no ip http server
no ip http secure-server
login block-for 120 attempts 3 within 60
login on-failure log
login on-success log
!
{% for server in ntp_servers %}
ntp server {{ server }}
{% endfor %}
!
{% for server in syslog_servers %}
logging host {{ server }}
{% endfor %}
logging trap informational
logging origin-id hostname
!
ip access-list standard MGMT-ACCESS
{% for host in jump_hosts %}
 permit {{ host }}
{% endfor %}
 deny   any log
!
